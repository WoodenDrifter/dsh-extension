{
  "name": "dsh-extension",
  "version": "2.0.0",
  "description": "为 dsh web 侧栏提供「拓展」面板：一个用来放置各种小功能的集合容器，支持分组折叠、拖拽排序、插件开关与中英文搜索。功能由其它插件注册进来。",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "extension-hub"
  ],
  "files": [
    "src/",
    "locale/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  }
}
